<Window x:Class="SpotifyNotch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpotifyNotch"
        Title="Spotify Notch" Width="528" Height="364"
        WindowStyle="None" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="0" Top="0" Focusable="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>

            <!-- faint dot matrix, tiled -->
            <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" Viewport="0,0,11,11" ViewportUnits="Absolute"
                          Viewbox="0,0,11,11" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="5.5,5.5" RadiusX="0.65" RadiusY="0.65"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <Style x:Key="IconBtn" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="Button"><Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="Pr"/></Grid.RenderTransform><Border x:Name="Hover" CornerRadius="20" Background="#26FFFFFF" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.07"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.07"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
</Setter.Value></Setter>
            </Style>

            <Style x:Key="PlayBtn" TargetType="Button">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="Width" Value="46"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="Button"><Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="Sc"/><ScaleTransform x:Name="Pr"/></TransformGroup></Grid.RenderTransform><Border CornerRadius="23" Background="White"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.07" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.07" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.07"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.07"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
</Setter.Value></Setter>
            </Style>

            <Style x:Key="SmallBtn" TargetType="Button">
                <Setter Property="Foreground" Value="#BFFFFFFF"/>
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="Button"><Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="Pr"/></Grid.RenderTransform><Border x:Name="Hover" CornerRadius="17" Background="#26FFFFFF" Opacity="0"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.07"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.07"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Pr" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
</Setter.Value></Setter>
            </Style>

            <Style x:Key="PillBtn" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="Button"><Grid><Border CornerRadius="14" Background="#2EFFFFFF"/><Border x:Name="Hover" CornerRadius="14" Background="#26FFFFFF" Opacity="0"/><ContentPresenter Margin="12,6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
</Setter.Value></Setter>
            </Style>

            <Style x:Key="RowBtn" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="Button"><Grid><Border x:Name="Hover" CornerRadius="9" Background="#26FFFFFF" Opacity="0"/><ContentPresenter Margin="8,0" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger></ControlTemplate.Triggers></ControlTemplate>
</Setter.Value></Setter>
            </Style>

            <Style x:Key="ApplyBtn" TargetType="Button">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="Button"><Grid><Border CornerRadius="14" Background="White"/><Border x:Name="Hover" CornerRadius="14" Background="#1F000000" Opacity="0"/><ContentPresenter Margin="13,6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
</Setter.Value></Setter>
            </Style>

            <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
                <Setter Property="Width" Value="7"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
                                       ViewportSize="{TemplateBinding ViewportSize}">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#59FFFFFF" CornerRadius="3" Margin="1,0"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SwitchToggle" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="ToggleButton"><Grid Width="42" Height="24"><Border CornerRadius="12" Background="#47FFFFFF"/><Border x:Name="OnFill" CornerRadius="12" Background="#1ED760" Opacity="0"/><Border x:Name="Hover" CornerRadius="12" Background="#26FFFFFF" Opacity="0"/><Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"><Ellipse.RenderTransform><TranslateTransform x:Name="KnobMove"/></Ellipse.RenderTransform></Ellipse></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsChecked" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="OnFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="OnFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="KnobMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
</Setter.Value></Setter>
            </Style>

            <Style x:Key="SegBtn" TargetType="RadioButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value>
<ControlTemplate TargetType="RadioButton"><Grid><Border x:Name="Sel" CornerRadius="9" Background="White" Opacity="0"/><Border x:Name="Hover" CornerRadius="9" Background="#26FFFFFF" Opacity="0"/><TextBlock Text="{TemplateBinding Content}" Margin="12,5" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Foreground><SolidColorBrush x:Name="LabelBrush" Color="White"/></TextBlock.Foreground></TextBlock></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.26"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsChecked" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><ColorAnimation Storyboard.TargetName="LabelBrush" Storyboard.TargetProperty="Color" To="Black" Duration="0:0:0.18"><ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction></ColorAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Sel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><ColorAnimation Storyboard.TargetName="LabelBrush" Storyboard.TargetProperty="Color" To="White" Duration="0:0:0.18"><ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction></ColorAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate>
</Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Canvas>
        <!-- invisible element animated at the display refresh rate while the notch moves: it keeps WPF's frame clock
             at full speed from the first frame (otherwise the first few frames of an animation come at 60 Hz) -->
        <Rectangle x:Name="FrameClock" Width="1" Height="1" Fill="Black" Opacity="0" IsHitTestVisible="False"/>
        <!-- the silhouette (a hair off-black so the neon reads as light on a dark surface) -->
        <Path x:Name="NotchPath" Fill="#050507"/>

        <!-- expanded content: fixed layout, revealed by the animated clip -->
        <Grid x:Name="ExpHost" Canvas.Left="24" Canvas.Top="0" Width="480" Height="340" Opacity="0">

            <!-- background layers: neon wave, dot grid, legibility scrim -->
            <local:AmbientBackground x:Name="Ambient" VerticalAlignment="Top" Height="184"/>
            <Rectangle x:Name="DotGrid" Fill="{StaticResource DotGridBrush}" Opacity="0.24" IsHitTestVisible="False" VerticalAlignment="Top" Height="184">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#33000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
                <Rectangle.CacheMode><BitmapCache RenderAtScale="2"/></Rectangle.CacheMode>
            </Rectangle>
            <Rectangle x:Name="Scrim" IsHitTestVisible="False" VerticalAlignment="Top" Height="184">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#B0050507" Offset="0"/>
                        <GradientStop Color="#4A050507" Offset="0.5"/>
                        <GradientStop Color="#10050507" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid x:Name="MainContent" Margin="18,16,18,10" VerticalAlignment="Top" Height="158">
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- album art: new cover slides in over the old one -->
                    <Grid x:Name="ArtHost" Width="84" Height="84" Background="#262626">
                        <Grid.Clip><RectangleGeometry Rect="0,0,84,84" RadiusX="11" RadiusY="11"/></Grid.Clip>
                        <Grid.RenderTransform><TranslateTransform x:Name="ArtShift"/></Grid.RenderTransform>
                        <Image x:Name="ArtPrev" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0">
                            <Image.RenderTransform><TranslateTransform x:Name="ArtPrevShift"/></Image.RenderTransform>
                        </Image>
                        <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform><TranslateTransform x:Name="ArtNewShift"/></Image.RenderTransform>
                        </Image>
                    </Grid>

                    <Grid x:Name="TextCol" Grid.Column="1" Margin="16,1,0,0">
                        <Grid.RenderTransform><TranslateTransform x:Name="TextShift"/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="TitleClip" ClipToBounds="True" Margin="0,0,96,0">
                            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="18"
                                       FontWeight="SemiBold" Foreground="White" TextWrapping="NoWrap"
                                       HorizontalAlignment="Left">
                                <TextBlock.RenderTransform><TranslateTransform x:Name="TitleMove"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="ArtistText" Grid.Row="1" FontSize="13" Foreground="#B3FFFFFF"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        <local:BarsControl x:Name="Bars" Grid.Row="2" Height="22" VerticalAlignment="Bottom"
                                           Margin="0,6,0,0" IsHitTestVisible="False"/>

                        <!-- background settings -->
                        <Button x:Name="SettingsBtn" Grid.RowSpan="3" Style="{StaticResource SmallBtn}" Width="30" Height="30"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0" ToolTip="Background settings">
                            <local:LucideIcon Data="{StaticResource Icon.Settings}" Width="16" Height="16"/>
                        </Button>
                    </Grid>

                    <Border x:Name="VolPill" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,30,0"
                            Background="#E61F1F1F" CornerRadius="11" Padding="8,3" Opacity="0" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <local:LucideIcon Data="{StaticResource Icon.Volume}" Width="13" Height="13"
                                              Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VolText" Text="50%" FontSize="12" FontWeight="Medium" Foreground="White"
                                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="ProgRow" Grid.Row="1" Margin="0,6,0,0">
                    <Grid.RenderTransform><TranslateTransform x:Name="ProgShift"/></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PosText" Text="0:00" FontSize="11" FontWeight="Medium" Foreground="#B3FFFFFF"
                               Width="34" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <Grid x:Name="Track" Grid.Column="1" Height="20" Background="Transparent" Cursor="Hand" Margin="6,0">
                        <Border Height="4" CornerRadius="2" Background="#40FFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="ProgFill" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Width="0"/>
                        <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="White" HorizontalAlignment="Left"
                                 VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbMove"/></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" FontSize="11" FontWeight="Medium"
                               Foreground="#B3FFFFFF" Width="34" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <Grid x:Name="Controls" Grid.Row="2" VerticalAlignment="Center">
                    <Grid.RenderTransform><TranslateTransform x:Name="ControlsShift"/></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Web API extras: only shown once Spotify is connected -->
                    <StackPanel x:Name="LeftExtras" Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Button x:Name="SourcesBtn" Style="{StaticResource SmallBtn}" ToolTip="Sources: which app the notch follows">
                            <local:LucideIcon Data="{StaticResource Icon.AudioLines}" Width="17" Height="17"/>
                        </Button>
                        <Button x:Name="QueueBtn" Style="{StaticResource SmallBtn}" ToolTip="Up next">
                            <local:LucideIcon Data="{StaticResource Icon.ListMusic}" Width="17" Height="17"/>
                        </Button>
                        <Button x:Name="DevicesBtn" Style="{StaticResource SmallBtn}" ToolTip="Devices">
                            <local:LucideIcon Data="{StaticResource Icon.MonitorSpeaker}" Width="17" Height="17"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ShuffleBtn" Style="{StaticResource SmallBtn}" Visibility="Collapsed" ToolTip="Shuffle">
                            <local:LucideIcon Data="{StaticResource Icon.Shuffle}" Width="17" Height="17"/>
                        </Button>

                        <Button x:Name="PrevBtn" Style="{StaticResource IconBtn}">
                            <local:LucideIcon Data="{StaticResource Icon.SkipBack}" Width="19" Height="19" Filled="True"/>
                        </Button>

                        <Button x:Name="PlayBtn" Style="{StaticResource PlayBtn}" Margin="10,0">
                            <Grid Width="22" Height="22">
                                <local:LucideIcon x:Name="PlayIcon" Data="{StaticResource Icon.Play}" Width="22" Height="22"
                                                  Filled="True" RenderTransformOrigin="0.5,0.5">
                                    <local:LucideIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="PlayScale"/>
                                            <TranslateTransform X="1.5"/>
                                        </TransformGroup>
                                    </local:LucideIcon.RenderTransform>
                                </local:LucideIcon>
                                <local:LucideIcon x:Name="PauseIcon" Data="{StaticResource Icon.Pause}" Width="22" Height="22"
                                                  Filled="True" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <local:LucideIcon.RenderTransform><ScaleTransform x:Name="PauseScale"/></local:LucideIcon.RenderTransform>
                                </local:LucideIcon>
                            </Grid>
                        </Button>

                        <Button x:Name="NextBtn" Style="{StaticResource IconBtn}">
                            <local:LucideIcon Data="{StaticResource Icon.SkipForward}" Width="19" Height="19" Filled="True"/>
                        </Button>

                        <Button x:Name="RepeatBtn" Style="{StaticResource SmallBtn}" Visibility="Collapsed" ToolTip="Repeat">
                            <local:LucideIcon x:Name="RepeatIcon" Data="{StaticResource Icon.Repeat}" Width="17" Height="17"/>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="RightExtras" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="HeartBtn" Style="{StaticResource SmallBtn}" ToolTip="Like">
                            <local:LucideIcon x:Name="HeartIcon" Data="{StaticResource Icon.Heart}" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>

                    <Button x:Name="ConnectBtn" Grid.Column="2" Style="{StaticResource PillBtn}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed" Content="Connect Spotify"
                            ToolTip="Sign in for likes, devices, queue, shuffle and repeat"/>
                </Grid>
            </Grid>
            <!-- slide-in page for devices / queue -->
            <Grid x:Name="PagePanel" Visibility="Collapsed" Opacity="0" Background="#FF050507">
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Height="30">
                        <Button x:Name="PageBack" Style="{StaticResource SmallBtn}" Width="30" Height="30" HorizontalAlignment="Left">
                            <local:LucideIcon Data="{StaticResource Icon.ChevronLeft}" Width="18" Height="18"/>
                        </Button>
                        <TextBlock x:Name="PageTitle" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock x:Name="PageCount" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5"
                                   Foreground="#99FFFFFF" Margin="0,0,4,0"/>
                    </Grid>

                    <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel x:Name="PageRows"/>
                    </ScrollViewer>

                    <StackPanel x:Name="SettingsRows" Grid.Row="1" Margin="2,6,2,0" Visibility="Collapsed">
                        <Grid Height="31">
                            <TextBlock Text="Dotted background" FontSize="13.5" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="DotsToggle" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Height="31">
                            <TextBlock Text="Blobs" FontSize="13.5" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="BlobsToggle" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid x:Name="BlobColorRow" Height="31">
                            <TextBlock Text="Blob colors" FontSize="13.5" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="11" Background="#2EFFFFFF" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ColorsDefault" GroupName="blobcolors" Style="{StaticResource SegBtn}" Content="Default"
                                                 ToolTip="Neon cyan, violet and magenta, leaning toward the cover"/>
                                    <RadioButton x:Name="ColorsAlbum" GroupName="blobcolors" Style="{StaticResource SegBtn}" Content="Album cover"
                                                 ToolTip="Colours taken from the current cover"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid x:Name="StillRow" Height="31">
                            <TextBlock Text="Still blobs" FontSize="13.5" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="StillToggle" Style="{StaticResource SwitchToggle}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Keep the blobs from drifting (reduce motion)"/>
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="PageFooter" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PageHint" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="QueueResetBtn" Grid.Column="1" Style="{StaticResource PillBtn}" Content="Reset"
                                Margin="8,0,0,0" Visibility="Collapsed"/>
                        <Button x:Name="QueueApplyBtn" Grid.Column="2" Style="{StaticResource ApplyBtn}" Content="Apply order"
                                Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- short status messages ("Added to Liked Songs", errors) -->
            <Border x:Name="ToastPill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,48,0"
                    Background="#F01F1F1F" CornerRadius="11" Padding="10,4" Opacity="0" IsHitTestVisible="False" MaxWidth="300">
                <TextBlock x:Name="ToastText" FontSize="12" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- peek content: slim bar shown briefly on track change -->
        <Grid x:Name="PeekHost" Canvas.Left="99" Canvas.Top="0" Width="330" Height="38" Opacity="0" IsHitTestVisible="False">
            <Rectangle VerticalAlignment="Bottom" Height="14">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop x:Name="PeekGlowTop" Color="#00FFFFFF" Offset="0"/>
                        <GradientStop x:Name="PeekGlowBottom" Color="#3C1ED760" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Image x:Name="PeekArt" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="14,0,0,0" Stretch="UniformToFill">
                <Image.Clip><RectangleGeometry Rect="0,0,22,22" RadiusX="5" RadiusY="5"/></Image.Clip>
            </Image>
            <TextBlock x:Name="PeekText" Margin="46,0,56,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"
                       Foreground="White" TextTrimming="CharacterEllipsis"/>
            <local:BarsControl x:Name="PeekBars" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Width="26" Height="14" Margin="0,0,16,0"/>
        </Grid>
    </Canvas>
</Window>
